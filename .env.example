# Copy to .env; set UID/GID to the Linux account owning the mounted folders.
LOCAL_UID=1000
LOCAL_GID=1000
GPU_DEVICE_ID=0
JUPYTER_PORT=8888
PIXAL_IMAGE=pixal3d:torch2.11-cu128-sm120
CUDA_ARCH_LIST=12.0
BUILD_JOBS=4
# For one image targeting both RTX 4090 and 5090:
# CUDA_ARCH_LIST=8.9;12.0
# PIXAL_IMAGE=pixal3d:torch2.11-cu128-sm89-sm120
# For release builds, BASE_IMAGE can be pinned to a verified registry digest.
# Do not put Hugging Face tokens in this file. Use hf auth login at runtime.
